# Entorno local de desarrollo (compatible con la API de Supabase)
# Copiá este archivo como `.env.local` para trabajar sin un proyecto Supabase.
#
# En Supabase real, reemplazá estas dos variables por la URL del proyecto y la
# clave pública (publishable / anon). Nada más cambia del lado del sitio.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-anon-key
