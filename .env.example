# =============================================================================
# Estudio Jurídico Casoratti — variables de entorno
# Copiá este archivo como `.env` y completá los valores.
# Las variables VITE_* son públicas (viajan en el bundle del navegador): nunca
# pongas ahí la service role key.
# =============================================================================

# --- Frontend (públicas) ---------------------------------------------------
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Project Settings → API → Publishable key (la "anon" nueva) o la legacy anon key
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase (servidor / Edge Functions) ----------------------------------
# Sólo para la CLI y las Edge Functions. NUNCA en el frontend.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Ancla/clave para el hash de IP del rate limiting (cualquier string largo y aleatorio)
RATE_LIMIT_SALT=cambiala-por-un-valor-aleatorio-largo
# Origen permitido por CORS en la Edge Function (URL del sitio publicado)
SITE_ORIGIN=http://localhost:3000

# --- Desarrollo local ------------------------------------------------------
# Opcional: puerto del servidor de desarrollo de Vite.
PORT=3000
